# Application
ENVIRONMENT=development
APP_NAME=DocSense Backend
APP_VERSION=0.1.0
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8000

# Database
# Local (Postgres via docker-compose on localhost)
DATABASE_URL=postgresql+psycopg://docsense:adminadmin@localhost:5432/docsense

# Auth / JWT
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
# CORS_ORIGINS=["http://localhost:3000"]

# Object Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Maximum allowed upload size in MB
MAX_FILE_SIZE_MB=10

# API
API_PREFIX=/api/v1