# Application
ENVIRONMENT=development
APP_NAME=DocSense Backend
APP_VERSION=0.1.0
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8000

# Database
# Local (Postgres via docker-compose on localhost)
DATABASE_URL=postgresql+psycopg://docsense:adminadmin@localhost:5432/docsense

# Auth / JWT
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
# CORS_ORIGINS=["http://localhost:3000"]

# API
API_PREFIX=/api/v1

# Object Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Maximum allowed upload size in MB
MAX_FILE_SIZE_MB=10
# Local directory for temporary PDF files during processing
LOCAL_TEMP_DIR=./tmp

# Chunking
# Maximum size (characters) of a single chunk
CHUNK_SIZE=500
# Overlap (characters) between consecutive chunks
CHUNK_OVERLAP=50

# Embeddings (Hugging Face Inference API)
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=Snowflake/snowflake-arctic-embed-m
EMBEDDING_DIMENSION=768
EMBEDDING_API_KEY=
HUGGINGFACE_TOKEN=
HUGGINGFACE_INFERENCE_URL=https://router.huggingface.co/v1

# LLM Provider (Groq)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CHAT_MODEL=llama-3.1-8b-instant

# Evidence Sufficiency Grading (FR-015)
# Number of top reranked chunks passed to the evidence grader
EVIDENCE_GRADING_TOP_K=4

# Bounded Corrective Retrieval (FR-016)
# Maximum corrective retrieval attempts before declaring evidence insufficient
CORRECTIVE_RETRIEVAL_MAX_ATTEMPTS=2
